CONFIG_TARGET_realtek=y
CONFIG_TARGET_realtek_rtl8197f=y
CONFIG_TARGET_realtek_rtl8197f_DEVICE_WF2409EV4=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# SSH-only image: no web UI.
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_uhttpd is not set
# CONFIG_PACKAGE_swconfig is not set
