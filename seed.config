# Netis WF2409E v4 seed config (rtl819x target, donor-based tree).
# Device packages (dnsmasq, kmod-rtl8192cd) come from the device's
# DEVICE_PACKAGES; target defaults (dropbear, uci, ...) from the target.
# Everything else is fed via make defconfig.

CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_Device_netis_wf2409e_v4=y

# Mandatory SQM (packages feed): sqm-scripts + CAKE + tc, explicitly
# pinned; prohibited: qosify/wshaper/qos-scripts/luci-app-sqm.
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched=y

# Onboard 2.4 GHz radio (donor rtl8192cd package) with wpad for STA/AP.
CONFIG_PACKAGE_kmod-rtl8192cd=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
