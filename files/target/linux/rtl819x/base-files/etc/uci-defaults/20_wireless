#!/bin/sh
# Netis WF2409E v4: seed the onboard 2.4 GHz radio (wf2409e_wlan, M2).
#
# netifd understands the mac80211 wiphy the clean-room module registers.
# The driver has no DT/efuse MAC path for the radio, so the per-unit
# WLAN MAC (base MAC + 2) is set from the same HS/config source the
# stock firmware uses: config (0x20000) first, HS backup (0x7fc000,
# stock mtd2 "netis") second. The eth0.x devices carry the eth MACs
# instead: LAN (eth0.2) = base, WAN (eth0.1) = base + 1 (see 02_network).

[ -e /etc/config/wireless ] || touch /etc/config/wireless
uci -q batch <<EOF
set wireless.radio0='wifi-device'
set wireless.radio0.type='mac80211'
set wireless.radio0.hwmode='11g'
set wireless.radio0.channel='6'
set wireless.radio0.htmode='HT20'
# Diagnostic boot build: the radio stays disabled at first boot so the
# M2 init chain (which netifd runs on ifup) cannot destabilize boot
# bring-up. Once the box is reachable over ssh, disarm with
#   uci set wireless.radio0.disabled=0; wifi
# and observe with netconsole. Remove this guard once wifi bring-up is
# proven stable end to end.
set wireless.radio0.disabled='1'
set wireless.default_radio0='wifi-iface'
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='OpenWrt-WF2409E'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='openwrt'
commit wireless
EOF

. /lib/functions/system.sh

# WLAN MAC = base + 2 (WAN is base + 1; see 02_network). config first,
# HS backup fallback — same order as stock (see 02_network comment).
wlan_mac=$(mtd_get_mac_binary config 0x3d 2>/dev/null) || wlan_mac=$(mtd_get_mac_binary netis 0x3d 2>/dev/null) || wlan_mac=""
case "$wlan_mac" in
[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F])
	uci -q set wireless.radio0.macaddress="$(macaddr_add "$wlan_mac" 2)"
	uci -q commit wireless
	;;
esac
