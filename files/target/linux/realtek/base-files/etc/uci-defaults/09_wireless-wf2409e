#!/bin/sh
#
# Seed the on-SoC 2.4 GHz radio on first boot. It is driven by the vendor
# rtl8192cd driver through WEXT, so it has no cfg80211 wiphy and `wifi config`
# cannot discover it; the wifi-device section has to be written here.
#
# The AP is open on purpose for the first bring-up: there is no wired port on
# the test unit, and this SSID is the only management path into the image.

[ -e /etc/Wireless ] || ln -s /tmp /etc/Wireless
[ -e /etc/config/wireless ] || touch /etc/config/wireless

uci -q get wireless.radio0 >/dev/null && exit 0

# config_generate puts the per-unit MAC on the LAN *device* section, not on
# the interface; ../board.d/02_network is the only writer of that value.
lan_mac=$(uci -q get network.lan_eth0_2_dev.macaddr)
case "$lan_mac" in
	[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) ;;
	*) lan_mac="" ;;
esac

suffix=$(printf '%s' "$lan_mac" | tr -d ':' | tail -c 4)
[ -n "$suffix" ] || suffix=0000

uci -q batch <<EOF
set wireless.radio0='wifi-device'
set wireless.radio0.type='rtl8192cd'
set wireless.radio0.hwmode='11g'
set wireless.radio0.channel='6'
set wireless.radio0.htmode='HT20'
set wireless.radio0.band='11'
set wireless.radio0.country='1'
set wireless.radio0.disabled='0'
set wireless.default_radio0='wifi-iface'
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='WF2409E-$suffix'
set wireless.default_radio0.encryption='none'
EOF

[ -n "$lan_mac" ] && uci -q set wireless.radio0.macaddr="$lan_mac"
uci -q commit wireless

exit 0
