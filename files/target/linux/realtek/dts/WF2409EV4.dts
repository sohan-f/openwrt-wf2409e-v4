/dts-v1/;

#include "RTL8197F.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "netis,wf2409e-v4", "realtek,rtl8197f-soc";
	model = "Netis WF2409E v4";

	memory {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	chosen {
		bootargs = "console=ttyS0,38400 root=/dev/mtdblock3 rootfstype=squashfs rootwait";
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		sys {
			label = "wf2409e:green:sys";
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		wps {
			label = "wf2409e:green:wps";
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
};

/*
 * The WF2409E has only the internal RTL865x 5-port switch. The ADCDS
 * rtl819x-eth driver otherwise force-configures port 0 as an RGMII trunk to
 * an external RTL8367S, which would turn a LAN jack into a dead RGMII port.
 */
&ethernet {
	realtek,no-external-switch;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&pcie0 {
	status = "disabled";
};

&wmac {
	status = "disabled";
};

&spi0 {
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <41000000>;

		partition@0 {
			label = "boot";
			reg = <0x0 0x20000>;
			read-only;
		};

		partition@20000 {
			label = "config";
			reg = <0x20000 0x10000>;
			read-only;
		};

		partition@30000 {
			label = "kernel";
			reg = <0x30000 0x2d0000>;
		};

		partition@300000 {
			label = "rootfs";
			reg = <0x300000 0x4bc000>;
		};

		/*
		 * Possible per-unit factory data (COMPHS-style calibration).
		 * Read-only and outside the OpenWrt image on purpose.
		 */
		partition@7bc000 {
			label = "factory";
			reg = <0x7bc000 0x3c000>;
			read-only;
		};

		partition@7f8000 {
			label = "netis";
			reg = <0x7f8000 0x4000>;
			read-only;
		};

		partition@7fc000 {
			label = "reserved";
			reg = <0x7fc000 0x4000>;
			read-only;
		};
	};
};
