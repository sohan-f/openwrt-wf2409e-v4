From 0672289559ea4432618531fc94b8ea51e4bf2fc2 Mon Sep 17 00:00:00 2001
From: wb <wb@local>
Date: Thu, 5 Nov 2026 00:00:00 +0000
Subject: [PATCH] wf2409e-dts

Front-panel GPIO map for the WF2409E v4 board: PEFGH gpio bank (E1/E3
lamps), gpio-leds and polled-button nodes pinned to the stock firmware
pin roles (15 = wps/reset lamp act.low, 17 = wps button, 19 = reset
button, 33 = activity lamp act.low, 35 = power lamp).

Signed-off-by: Sohan Ali <96324905+sohan-f@users.noreply.github.com>
---
 .../linux/rtl819x/dts/rtl8197f-wf2409ev4.dts  | 196 ++++++++++++++++++++++-
 1 file changed, 196 insertions(+)

diff --git a/target/linux/rtl819x/dts/rtl8197f-wf2409ev4.dts b/target/linux/rtl819x/dts/rtl8197f-wf2409ev4.dts
new file mode 100644
index 0000000..181a9c5
--- /dev/null
+++ b/target/linux/rtl819x/dts/rtl8197f-wf2409ev4.dts
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/dts-v1/;
+
+#include "rtl8197f.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+
+/ {
+	model = "Netis WF2409E v4";
+	compatible = "netis,wf2409e-v4", "realtek,rtl8197f";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x04000000>;
+	};
+
+	/*
+	 * SoC GPIO, ports A-D bank (PABCD) of the RTL8197F GPIO block at
+	 * 0x18003500, same generic mmio mapping the donor A2004MU port uses
+	 * (it bit-bangs switch SMI over gpio 18/19 there, so GPIO-mode is the
+	 * reset-default pin function on this SoC family).
+	 */
+	gpio: gpio@1800350c {
+		compatible = "brcm,bcm6345-gpio";
+		reg = <0x1800350c 0x4>, <0x18003508 0x4>;
+		reg-names = "dat", "dirout";
+		gpio-controller;
+		#gpio-cells = <2>;
+		ngpios = <32>;
+	};
+
+	/*
+	 * Ports E-H bank (PEFGH) at 0x1800351c: needed for the board's
+	 * activity (gpio 33, E1) and power (gpio 35, E3) lamps.
+	 */
+	gpio1: gpio@18003524 {
+		compatible = "brcm,bcm6345-gpio";
+		reg = <0x18003528 0x4>, <0x18003524 0x4>;
+		reg-names = "dat", "dirout";
+		gpio-controller;
+		#gpio-cells = <2>;
+		ngpios = <32>;
+		/*
+		 * gpio-mmio auto-assigns the lowest free base; pinning the
+		 * second bank to 32 keeps 33/35 addressable as gpio1:1/3 no
+		 * matter the probe order.
+		 */
+		gpio-mmio,base = <32>;
+	};
+
+	/*
+	 * Front-panel wiring, verified against the stock firmware itself
+	 * (live sysfs exports {15,17,19,33,35}, write-behavior experiments
+	 * on the friend's unit, and the MSDK BSP defaults C1/C3 = wps/reset
+	 * btn, B7 = wps/reset led):
+	 *   gpio 15 (B7): WPS+RESET lamp, active-LOW (stock idles it low =
+	 *                 lit; writing 1 dimmed it for the user)
+	 *   gpio 33 (E1): activity/internet lamp, active-LOW (stock idles it
+	 *                 low = lit, pulses high ~1 s under traffic)
+	 *   gpio 35 (E3): power lamp, active-HIGH (stock leaves it high)
+	 *   gpio 17 (C1): WPS button, active-LOW (stock input-locks the pin)
+	 *   gpio 19 (C3): RESET button, active-LOW (stock input-locks the pin)
+	 * LAN/WAN port lamps are driven by the switch-core LED engine, not
+	 * by these GPIOs.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led-wps {
+			label = "wf2409e:green:wps";
+			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led-power {
+			label = "wf2409e:green:power";
+			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+
+		led-activity {
+			label = "wf2409e:green:activity";
+			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
+			debounce-interval = <3>;
+		};
+
+		button-wps {
+			label = "wps";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
+			debounce-interval = <3>;
+		};
+	};
+};
+
+&spi0 {
+	flash@0 {
+		/*
+		 * Netis WF2409E v4 stock layout, derived from the friend's
+		 * working unit /proc/mtd plus a byte-level analysis of its
+		 * mtd blocks: boot region 0x0..0x20000, config 0x20000, kernel
+		 * header+payload at 0x30000 (cr6c, start 0x80a00000), squashfs
+		 * rootfs from 0x300000 to the netis data block at 0x7f8000.
+		 * The netis block holds the per-unit MAC at offset 0x3d.
+		 */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "bootloader";
+				reg = <0x00000000 0x00020000>;
+				read-only;
+			};
+
+			partition@20000 {
+				label = "config";
+				reg = <0x00020000 0x00010000>;
+				read-only;
+			};
+
+			partition@30000 {
+				label = "kernel";
+				reg = <0x00030000 0x002d0000>;
+			};
+
+			partition@300000 {
+				label = "rootfs";
+				reg = <0x00300000 0x004f8000>;
+			};
+
+			netis: partition@7f8000 {
+				label = "netis";
+				reg = <0x007f8000 0x00004000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_netis: mac-address@3d {
+						reg = <0x0000003d 0x6>;
+					};
+				};
+			};
+
+			partition@7fc000 {
+				label = "reserved";
+				reg = <0x007fc000 0x00004000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&eth0 {
+	/*
+	 * No "realtek,dsa-conduit" here: this board has no external switch,
+	 * so the ethernet driver programs the internal fabric's VLAN tables
+	 * directly (board patch 0003) instead of acting as a DSA conduit.
+	 */
+	nvmem-cells = <&macaddr_netis>;
+	nvmem-cell-names = "mac-address";
+};
+
+&wifi2g {
+	/*
+	 * No "calibration" nvmem cell: with the cell absent the rtl8192cd
+	 * driver reads RF calibration from the on-chip EFUSE.
+	 */
+	status = "okay";
+};
+
+&pcie {
+	/*
+	 * The WF2409E has no mini-PCIe card (its only radio is the integrated
+	 * 2.4 GHz one); disabling the root port keeps the unused controller
+	 * powered down.
+	 */
+	status = "disabled";
+};
