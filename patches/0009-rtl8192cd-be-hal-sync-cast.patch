From 8b619d0b6fa33cad90e59b3a2a0c139995fbacfe Mon Sep 17 00:00:00 2001
From: wb <wb@local>
Date: Wed, 4 Nov 2026 21:00:51 +0000
Subject: [PATCH] rtl8192cd: cast bus_to_virt result in HAL_CACHE_SYNC_WBACK
 for BE

The only uncast bus_to_virt site in the driver. Under CONFIG_NET_PCI
BE builds, HalCfg.h:1732 passes phys_to_virt()'s void* straight into
rtl_cache_sync_wback()'s unsigned long start parameter, and GCC 12+
makes implicit pointer-to-integer conversion a hard error
(-Wint-conversion), failing WlanHAL/RTL88XX/Hal88XXRxDesc.o (run
41900692751). All ~30 other call sites already wrap bus_to_virt in
(unsigned long); this just matches that pattern. Value semantics are
identical to the stock vendor build (implicit conversion).

Signed-off-by: Sohan Ali <96324905+sohan-f@users.noreply.github.com>
---
 package/kernel/rtl8192cd/src/WlanHAL/HalCfg.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/package/kernel/rtl8192cd/src/WlanHAL/HalCfg.h b/package/kernel/rtl8192cd/src/WlanHAL/HalCfg.h
index feca2a9..9bcf4f4 100644
--- a/package/kernel/rtl8192cd/src/WlanHAL/HalCfg.h
+++ b/package/kernel/rtl8192cd/src/WlanHAL/HalCfg.h
@@ -1729,7 +1729,7 @@ typedef struct stat_info        _HAL_STA_INFO,*P_HAL_STA_INFO;
 #define HAL_PCI_DMA_FROMDEVICE    PCI_DMA_FROMDEVICE
 
 #ifdef CONFIG_NET_PCI
-#define HAL_CACHE_SYNC_WBACK(Adapter, start, size, direction)   rtl_cache_sync_wback(Adapter, bus_to_virt(start), size, direction)
+#define HAL_CACHE_SYNC_WBACK(Adapter, start, size, direction)   rtl_cache_sync_wback(Adapter, (unsigned long)bus_to_virt(start), size, direction)
 #else
 #define HAL_CACHE_SYNC_WBACK(Adapter, start, size, direction)   rtl_cache_sync_wback(Adapter, start, size, direction)
 #endif
