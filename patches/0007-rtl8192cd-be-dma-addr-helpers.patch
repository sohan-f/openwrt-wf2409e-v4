From 3cbe6eaff9f4edf5dbda34b86944985f57cfe89d Mon Sep 17 00:00:00 2001
From: wb <wb@local>
Date: Wed, 4 Nov 2026 18:19:00 +0000
Subject: [PATCH] rtl8192cd: restore virt_to_bus/bus_to_virt fallbacks for
 big-endian kernels

The __MIPSEB__ branch of 8192cd_core_util.h assumed the stock Realtek
kernel kept the legacy virt_to_bus/bus_to_virt aliases (or CPHYSADDR for
kernels that pre-defined them as macros). Upstream MIPS io.h dropped both
aliases after 5.x, so with a big-endian kernel the macros fall through as
bare identifiers and core_osdep.o dies with implicit-declaration errors
(run 41874721686).

Add the same #ifndef fallback pair the little-endian branch has always
had. On 32-bit non-EVA MIPS virt_to_phys is exactly CPHYSADDR
(asm/page.h ___pa-masking path), so the semantics equal both the stock
vendor kernels (io.h: '#define virt_to_bus virt_to_phys') and the LE
builds.

Signed-off-by: Sohan Ali <96324905+sohan-f@users.noreply.github.com>
---
 package/kernel/rtl8192cd/src/core/8192cd_core_util.h | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/package/kernel/rtl8192cd/src/core/8192cd_core_util.h b/package/kernel/rtl8192cd/src/core/8192cd_core_util.h
index 6ec8569..b0ce8f6 100644
--- a/package/kernel/rtl8192cd/src/core/8192cd_core_util.h
+++ b/package/kernel/rtl8192cd/src/core/8192cd_core_util.h
@@ -80,6 +80,15 @@
 	#undef virt_to_bus
 	#define virt_to_bus			CPHYSADDR
 #endif
+/* Upstream removed the virt_to_bus/bus_to_virt legacy aliases from MIPS
+ * io.h after 5.x; fall back to what the stock Realtek kernels aliased
+ * them to. On 32-bit non-EVA MIPS virt_to_phys is exactly CPHYSADDR. */
+#ifndef virt_to_bus
+#define virt_to_bus			virt_to_phys
+#endif
+#ifndef bus_to_virt
+#define bus_to_virt			phys_to_virt
+#endif
 #else
 #ifndef virt_to_bus
 #define virt_to_bus	virt_to_phys
-- 
2.53.0

