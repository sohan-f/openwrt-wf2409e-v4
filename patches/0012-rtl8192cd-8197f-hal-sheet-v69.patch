--- a/package/kernel/rtl8192cd/src/data_RadioA_8197F.c	2026-11-05 17:38:18.872759523 +0000
+++ b/package/kernel/rtl8192cd/src/data_RadioA_8197F.c	2026-11-05 17:38:18.876759523 +0000
@@ -1,74 +1,154 @@
