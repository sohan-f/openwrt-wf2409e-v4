From 8ad7db2b2c63fa38584268ae43063ef128afee86 Mon Sep 17 00:00:00 2001
From: wb <wb@local>
Date: Wed, 4 Nov 2026 12:41:00 +0000
Subject: [PATCH] big-endian

Signed-off-by: Sohan Ali <96324905+sohan-f@users.noreply.github.com>
---
 target/linux/rtl819x/Makefile             | 2 +-
 target/linux/rtl819x/image/Makefile       | 8 ++++----
 target/linux/rtl819x/rtl8197f/config-6.18 | 1 +
 target/linux/rtl819x/rtl8197f/target.mk   | 2 +-
 4 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/target/linux/rtl819x/Makefile b/target/linux/rtl819x/Makefile
index e489144..ef1ae24 100644
--- a/target/linux/rtl819x/Makefile
+++ b/target/linux/rtl819x/Makefile
@@ -2,7 +2,7 @@
 
 include $(TOPDIR)/rules.mk
 
-ARCH:=mipsel
+ARCH:=mips
 BOARD:=rtl819x
 BOARDNAME:=Realtek RTL819x-class routers
 DEVICE_TYPE:=router
diff --git a/target/linux/rtl819x/image/Makefile b/target/linux/rtl819x/image/Makefile
index de406bb..c0d1fd7 100644
--- a/target/linux/rtl819x/image/Makefile
+++ b/target/linux/rtl819x/image/Makefile
@@ -49,10 +49,10 @@ define Build/loader-kernel
 	echo "kernel load=$$kload entry=$$kentry loader=$(LOADER_LOADADDR)"; \
 	echo "CFLAGS += -DKERNEL_LOAD=$$kload" >> $@.src/Makefile; \
 	$(MAKE) -C $@.src \
-		CC="$(TARGET_CC) -EL" \
-		LD="$(TARGET_CROSS)ld -EL" \
-		OBJDUMP="$(TARGET_CROSS)objdump -EL" \
-		O_FORMAT=elf32-tradlittlemips \
+		CC="$(TARGET_CC)" \
+		LD="$(TARGET_CROSS)ld" \
+		OBJDUMP="$(TARGET_CROSS)objdump" \
+		O_FORMAT=elf32-tradbigmips \
 		CROSS_COMPILE="$(TARGET_CROSS)" \
 		LOADADDR=$(LOADER_LOADADDR) \
 		KERNEL_ENTRY=$$kentry \
diff --git a/target/linux/rtl819x/rtl8197f/config-6.18 b/target/linux/rtl819x/rtl8197f/config-6.18
index b396ddf..2e5e100 100644
--- a/target/linux/rtl819x/rtl8197f/config-6.18
+++ b/target/linux/rtl819x/rtl8197f/config-6.18
@@ -2,6 +2,7 @@
 # Provisional RTL8197F-class Stage 0 kernel scaffold.
 
 CONFIG_MACH_REALTEK_RTL819X=y
+CONFIG_CPU_BIG_ENDIAN=y
 CONFIG_CPU_MIPS32_R2=y
 # CONFIG_CPU_MIPS32_R1 is not set
 # 24Kc has no hardware FPU; the kernel still needs FP support to accept the
diff --git a/target/linux/rtl819x/rtl8197f/target.mk b/target/linux/rtl819x/rtl8197f/target.mk
index 11423ff..441ab6c 100644
--- a/target/linux/rtl819x/rtl8197f/target.mk
+++ b/target/linux/rtl819x/rtl8197f/target.mk
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
-ARCH:=mipsel
+ARCH:=mips
 SUBTARGET:=rtl8197f
 CPU_TYPE:=24kc
 BOARDNAME:=Realtek RTL8197F-class SoCs
-- 
2.53.0

