diff --git a/target/linux/realtek/files-4.14/drivers/net/ethernet/rtl819x/rtl819x-eth.c b/target/linux/realtek/files-4.14/drivers/net/ethernet/rtl819x/rtl819x-eth.c
index 1035361..b710a70 100644
--- a/target/linux/realtek/files-4.14/drivers/net/ethernet/rtl819x/rtl819x-eth.c
+++ b/target/linux/realtek/files-4.14/drivers/net/ethernet/rtl819x/rtl819x-eth.c
@@ -440,6 +440,14 @@ static int trunk_pause = 2;
 module_param(trunk_pause, int, 0644);
 MODULE_PARM_DESC(trunk_pause, "RGMII-trunk 802.3x pause: 2=force OFF (default, A-2 residual fix), 1=force on (bench A/B collapse), 0=leave loader value");
 
+/*
+ * WF2409E v4 has no external RTL8367S: its five jacks are ports 0-4 of the
+ * internal RTL865x switch and the CPU is port 8. The DIR-842 RGMII-trunk
+ * bring-up below (P0GMIICR/PITCR/PCRP0, CPU tags, 8367S SMI) would force a
+ * jack into RGMII mode, so it is skipped when the board DTS says so.
+ */
+static bool rtl819x_external_switch = true;
+
 /* 8367S half of the trunk-pause fix (rtl8367b.c; CONFIG_RTL8367B_PHY=y, so
  * this built-in <-> built-in reference links into vmlinux). */
 extern int rtl8367s_trunk_pause_set(int on);
@@ -606,13 +614,16 @@ static void rtl865x_start(void)
 		 * stay symmetric (CPU in both); the literal 0x10 is only worth trying
 		 * as a deliberate A/B.
 		 *
-		 * untag stays 0x00: our 8367S sends 802.1Q-TAGGED up the trunk and the
-		 * SoC reads the VID from the tag -- measured working. (The vendor
-		 * instead sends untagged and derives the VID from the ingress port's
-		 * PVID; both are coherent, ours is already proven.)
+		 * Egress tagging: the DIR-842's external 8367S expects tagged
+		 * frames on the trunk, so every member stays tagged. On the
+		 * internal-switch board the jacks are real PHY ports and must
+		 * egress untagged; only the CPU port stays tagged so RX keeps
+		 * the VLAN identity.
 		 */
-		sw_add_vlan_fid(RTL865X_VID_LAN, 0x10F, 0x00, 0); /* jacks 0-3 + CPU8, fid0 */
-		sw_add_vlan_fid(RTL865X_VID_WAN, 0x110, 0x00, 1); /* jack 4    + CPU8, fid1 */
+		sw_add_vlan_fid(RTL865X_VID_LAN, 0x10F,
+				rtl819x_external_switch ? 0x000 : 0x00F, 0);
+		sw_add_vlan_fid(RTL865X_VID_WAN, 0x110,
+				rtl819x_external_switch ? 0x000 : 0x010, 1);
 		/* Per-jack PVID now that ports are distinct: the WAN jack must default
 		 * to the WAN VID, not LAN. Only matters for untagged ingress, but
 		 * leaving every port on LAN would mis-zone the WAN jack the moment
@@ -653,6 +664,7 @@ static void rtl865x_start(void)
 		       REG32(RTL819X_SWCORE_BASE + 0x5108),
 		       REG32(RTL819X_SWCORE_BASE + 0x4058),
 		       REG32(0xB8000850));
+		if (rtl819x_external_switch) {
 		/* A-2 (M7.3 fabric-wedge prevention): MACCR back-pressure LONG_TXE
 		 * (bit22) + CF_SYSCLK_SEL, set UNCONDITIONALLY — the fabric fix must
 		 * apply on loader/RAM boots too, not only the gated cold path below.
@@ -791,6 +803,7 @@ static void rtl865x_start(void)
 		       REG32(RTL819X_SWCORE_BASE + 0x414C),
 		       REG32(RTL819X_SWCORE_BASE + 0x4000),
 		       REG32(RTL819X_SWCORE_BASE + 0x4104));
+		}
 
 		REG32(MSCR) |= MSCR_EN_L2;		/* global L2 forwarding enable (LAST) */
 	}
@@ -1554,6 +1567,9 @@ static int rtl819x_eth_probe(struct platform_device *pdev)
 	else
 		eth_hw_addr_random(dev);
 
+	rtl819x_external_switch = !of_property_read_bool(pdev->dev.of_node,
+							"realtek,no-external-switch");
+
 	New_swNic_setDev(dev);
 	platform_set_drvdata(pdev, dev);
 
